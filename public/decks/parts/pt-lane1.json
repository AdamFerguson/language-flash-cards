        { "term": "o pai", "en": "the father", "example": "O pai dela viaja toda semana.", "exampleEn": "Her father travels every week." },
        { "term": "a mãe", "en": "the mother", "example": "A mãe dela trabalha comigo.", "exampleEn": "Her mother works with me." },
        { "term": "o filho", "en": "the son", "example": "O filho deles estuda medicina.", "exampleEn": "Their son studies medicine." },
        { "term": "a filha", "en": "the daughter", "example": "A filha dela tem dois anos.", "exampleEn": "Her daughter is two years old." },
        { "term": "o irmão", "en": "the brother", "example": "O irmão dela é engenheiro.", "exampleEn": "Her brother is an engineer." },
        { "term": "a irmã", "en": "the sister", "example": "A irmã mais nova mora longe.", "exampleEn": "The younger sister lives far away." },
        { "term": "o marido", "en": "the husband", "example": "O marido dela cozinha muito bem.", "exampleEn": "Her husband cooks very well." },
        { "term": "a esposa", "en": "the wife", "example": "Ele saiu com a esposa.", "exampleEn": "He went out with his wife." },
        { "term": "os pais", "en": "the parents", "example": "Amo muito os meus pais.", "exampleEn": "I love my parents very much." },
        { "term": "o avô", "en": "the grandfather", "example": "O avô conta histórias antigas.", "exampleEn": "Grandpa tells old stories." },
        { "term": "a avó", "en": "the grandmother", "example": "A avó faz um bolo delicioso.", "exampleEn": "Grandma makes a delicious cake." },
        { "term": "a criança", "en": "the child", "example": "A criança dormiu cedo.", "exampleEn": "The child went to sleep early." },
        { "term": "o bebê", "en": "the baby", "example": "O bebê dorme a noite inteira.", "exampleEn": "The baby sleeps the whole night." },
        { "term": "o amigo", "en": "the friend", "example": "Meu melhor amigo mora aqui.", "exampleEn": "My best friend lives here." },
        { "term": "a pessoa", "en": "the person", "example": "Ele é uma pessoa gentil.", "exampleEn": "He is a kind person." }
